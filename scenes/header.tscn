[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/header.gd" id="1_script"]
[ext_resource type="Theme" path="res://theme/launcher_theme.tres" id="2_theme"]

[node name="Header" type="PanelContainer"]
custom_minimum_size = Vector2(0, 140)
theme = ExtResource("2_theme")
theme_type_variation = &"HeaderPanel"
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 14

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="LogoSlot" type="Control" parent="Margin/Row"]
custom_minimum_size = Vector2(300, 108)
layout_mode = 2

[node name="Logo" type="TextureRect" parent="Margin/Row/LogoSlot"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
expand_mode = 1
stretch_mode = 5

[node name="LogoPlaceholder" type="PanelContainer" parent="Margin/Row/LogoSlot"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"LogoPlaceholder"

[node name="LogoHint" type="Label" parent="Margin/Row/LogoSlot/LogoPlaceholder"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LogoHintLabel"
text = "YOUR LOGO HERE
assets/logo.png"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Names" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
theme_override_constants/separation = 2
alignment = 1

[node name="TeamName" type="Label" parent="Margin/Row/Names"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TeamNameLabel"
text = "YOUR TEAM NAME"

[node name="Tagline" type="Label" parent="Margin/Row/Names"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TaglineLabel"
text = "Your tagline here"

[node name="Spacer" type="Control" parent="Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Right" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
alignment = 1

[node name="Clock" type="Label" parent="Margin/Row/Right"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ClockLabel"
text = "12:00"
horizontal_alignment = 2

[node name="ControllerStatus" type="Label" parent="Margin/Row/Right"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatusLabel"
text = "1 controller connected"
horizontal_alignment = 2
