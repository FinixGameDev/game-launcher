theme_type_variation = &"OverlayPanel"

[node name="Column" type="VBoxContainer" parent="Center/Card"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Center/Card/Column"]
unique_name_in_owner = true
layout_mode = 2
