[ext_resource type="Theme" path="res://theme/launcher_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/button_hint.tscn" id="3_hint"]

[node name="Footer" type="PanelContainer"]
custom_minimum_size = Vector2(0, 84)
